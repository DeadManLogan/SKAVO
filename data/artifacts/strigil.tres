[resource]
script = ExtResource("1_s8h5t")
name = "Bronze Strigil"
era = "Roman Empire, 1st century AD"
blurb = "No soap at the baths? No problem. Romans rubbed olive oil into their skin, then scraped it off with a strigil, taking the sweat and dirt with it. The wealthy had a slave do the scraping. And the gunk? Pliny the Elder writes that scrapings from athletes were sold as medicine. Please don't try this at home."
metadata/_custom_type_script = "uid://c672t7ojkx2e3"
